{
  "name": "ecogents",
  "version": "2.0.0",
  "description": "TypeScript implementation of the Ecological Generative System (EGS) from Karth 2023",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type: 'module'}))\"",
    "dev": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "demo": "npm run build && node dist/examples/demo.js",
    "elite": "npm run build && node dist/examples/eliteExample.js",
    "story": "npm run build && node dist/examples/storyExample.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "bench": "npm run build && node bench/bench.js"
  },
  "keywords": [
    "procedural-generation",
    "procgen",
    "ecological-generator",
    "blackboard-architecture",
    "game-development",
    "generative-systems"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "commander": "^12.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  }
}
