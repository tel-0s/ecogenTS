{
  "name": "ecogents",
  "version": "1.0.0",
  "description": "TypeScript implementation of the Ecological Generative System (EGS) from Karth 2023",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "demo": "npm run build && node dist/examples/demo.js",
    "elite": "npm run build && node dist/examples/eliteExample.js",
    "story": "npm run build && node dist/examples/storyExample.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "procedural-generation",
    "procgen",
    "ecological-generator",
    "blackboard-architecture",
    "game-development",
    "generative-systems"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "crypto": "^1.0.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
